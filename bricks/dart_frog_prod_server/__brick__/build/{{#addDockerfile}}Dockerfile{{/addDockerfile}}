# Official Dart image: https://hub.docker.com/_/dart
FROM dart:{{dartVersion}} AS build

WORKDIR /app
{{#hasExternalDependencies}}COPY ./.dart_frog_path_dependencies  ./.dart_frog_path_dependencies{{/hasExternalDependencies}}
{{#hasExternalDependencies}}COPY ./pubspec_overrides.yaml ./pubspec_overrides.yaml{{/hasExternalDependencies}}
{{#pathDependencies}}COPY {{{.}}} ./{{{.}}}
{{/pathDependencies}}
{{^hasExternalDependencies}}{{#pathDependencies}}RUN dart pub get -C {{{.}}}
{{/pathDependencies}}
{{/hasExternalDependencies}}
# Copy dependencies
COPY pubspec.* ./
COPY pubspec_overrides.yaml* ./
RUN dart pub get

# Copy app source
COPY . .

# Ensure packages are still up-to-date if anything has changed
RUN dart pub get --offline

# AOT compile
RUN dart build cli -t bin/server.dart -o /dist

# Build minimal serving image from AOT-compiled `/dist` and required system
# libraries and configuration files stored in `/runtime/` from the build stage
FROM scratch
COPY --from=build /runtime/ /
COPY --from=build /dist/bundle/ /app/
{{#serveStaticFiles}}COPY --from=build /app/public /public/{{/serveStaticFiles}}

# Start server.
CMD ["/app/bin/server"]
